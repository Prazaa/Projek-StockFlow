<?xml version="1.0" encoding="utf-8"?>
<!--
  Form penyesuaian stok — draft.html adjustPage().
  Contoh: batch SUN-2412A (Sunlight 755ml), sisa 5 pcs, jumlah awal 24 -> rentang akhir 0 – 24 pcs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Penyesuaian"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Form intro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <TextView
                    style="@style/SF.Text.Title"
                    android:text="Penyesuaian stok" />

                <TextView
                    style="@style/SF.Text.Muted"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Gunakan untuk mengoreksi selisih hitung fisik. Nilai boleh negatif, tetapi sisa akhir tidak boleh kurang dari 0 atau melebihi jumlah awal (CHECK constraint)."
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Kartu ringkas batch -->
            <LinearLayout
                style="@style/SF.Card"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/bg_product_home">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_droplet"
                        app:tint="#397A55" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.RowTitle"
                        android:text="Sunlight 755ml" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SF.Text.BatchCode"
                            android:text="SUN-2412A" />

                        <TextView
                            style="@style/SF.Text.RowSub"
                            android:text=" · sisa saat ini 5 pcs" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/SF.Pill.Safe"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic12_check_circle"
                    android:text="Aman" />
            </LinearLayout>

            <!-- Section: Selisih -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_swap_horiz"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Selisih" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Boleh negatif"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <!-- Selisih jumlah -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Selisih jumlah" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/adjust_selisih"
                    style="@style/SF.Input"
                    android:layout_marginTop="5dp"
                    android:hint="Contoh: -2"
                    android:inputType="numberSigned" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="5dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Rentang akhir: 0 – 24 pcs." />

                <!-- Status preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_status_preview"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sisa setelah penyesuaian" />

                    <TextView
                        android:id="@+id/adjust_preview"
                        style="@style/SF.Pill.Safe"
                        android:text="5 pcs" />
                </LinearLayout>

                <!-- Alasan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Alasan penyesuaian" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_alasan"
                    style="@style/SF.Input"
                    android:layout_marginTop="5dp"
                    android:gravity="top"
                    android:hint="Contoh: Koreksi stok opname mingguan."
                    android:inputType="textMultiLine"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLength="255"
                    android:minHeight="76dp" />
            </LinearLayout>

            <!-- Form note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_alert_info"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_clipboard_check"
                    app:tint="#35647E" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Penyesuaian dicatat sebagai mutasi penyesuaian dengan nilai selisih (bisa negatif) dan riwayat aktivitas ubah batch_stok."
                    android:textColor="#35647E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sumber -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_marginStart="4dp"
                    android:text="Sumber: mutasi_stok.jenis = penyesuaian · chk_batch_sisa_nonnegatif"
                    android:textColor="@color/sf_muted_2"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Actionbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_actionbar"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/btn_batal"
            style="@style/SF.Btn.Ghost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Batal" />

        <TextView
            android:id="@+id/btn_simpan"
            style="@style/SF.Btn.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic12_save"
            android:text="Simpan selisih" />
    </LinearLayout>
</LinearLayout>
