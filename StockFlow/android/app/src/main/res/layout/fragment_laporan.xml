<?xml version="1.0" encoding="utf-8"?>
<!--
  Laporan pemilik — draft.html reportsPage() + reportTabs() + reportStock().
  Data contoh = seed stockflow_database.sql (30 Okt 2026). Tab aktif: Laporan, sub-tab Stok.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <!-- Topbar tab utama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="66dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SF.Text.Title"
                android:singleLine="true"
                android:text="Laporan"
                android:textSize="18sp" />

            <TextView
                style="@style/SF.Text.Caption"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:text="Stok, mutasi &amp; audit" />
        </LinearLayout>

        <!-- Notifikasi + badge -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                style="@style/SF.IconBtn"
                android:src="@drawable/ic_bell" />

            <TextView
                style="@style/SF.Text"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/sf_on_brand"
                android:textSize="8sp" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Tab laporan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segmented"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:singleLine="true"
                    android:text="Stok"
                    android:textColor="@color/sf_brand"
                    android:textSize="11sp" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:singleLine="true"
                    android:text="Mutasi"
                    android:textColor="#6E8277"
                    android:textSize="11sp" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:singleLine="true"
                    android:text="Kedaluwarsa"
                    android:textColor="#6E8277"
                    android:textSize="11sp" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:singleLine="true"
                    android:text="Aktivitas"
                    android:textColor="#6E8277"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Ringkasan 3 metrik -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="5" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="barang aktif" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="215" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="unit tersedia" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="2"
                        android:textColor="@color/sf_warn" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="stok menipis" />
                </LinearLayout>
            </LinearLayout>

            <!-- Header + CSV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="31dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.Section"
                        android:text="Stok tersedia" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="3dp"
                        android:text="View v_stok_tersedia · batch kedaluwarsa &amp; ditangani tidak dihitung" />
                </LinearLayout>

                <TextView
                    style="@style/SF.Btn.Ghost"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:drawableStart="@drawable/ic12_download"
                    android:paddingHorizontal="12dp"
                    android:text="CSV"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Daftar stok -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="3dp">

                <!-- Indomie Goreng -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:paddingVertical="10dp">

                    <FrameLayout
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_product_food">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cookie"
                            app:tint="#9A6515" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Indomie Goreng" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="SKU-MKN-001 · Makanan" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SF.Text.Strong"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:text="150"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/SF.Text.Caption"
                                android:layout_marginStart="3dp"
                                android:text="pcs" />
                        </LinearLayout>

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="min. 50" />
                    </LinearLayout>

                    <TextView
                        style="@style/SF.Pill.Safe"
                        android:layout_marginStart="9dp"
                        android:drawableStart="@drawable/ic12_check_circle"
                        android:text="Aman" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <!-- Ultra Milk -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:paddingVertical="10dp">

                    <FrameLayout
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_product_drink">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cup"
                            app:tint="#2C6B93" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Ultra Milk Full Cream 250ml" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="SKU-MNM-001 · Minuman" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SF.Text.Strong"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:text="40"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/SF.Text.Caption"
                                android:layout_marginStart="3dp"
                                android:text="pcs" />
                        </LinearLayout>

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="min. 20" />
                    </LinearLayout>

                    <TextView
                        style="@style/SF.Pill.Safe"
                        android:layout_marginStart="9dp"
                        android:drawableStart="@drawable/ic12_check_circle"
                        android:text="Aman" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <!-- Paracetamol -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:paddingVertical="10dp">

                    <FrameLayout
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_product_med">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_pill"
                            app:tint="#9D4D59" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Paracetamol 500mg" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="SKU-UBT-001 · Obat" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SF.Text.Strong"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:text="20"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/SF.Text.Caption"
                                android:layout_marginStart="3dp"
                                android:text="box" />
                        </LinearLayout>

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="min. 10" />
                    </LinearLayout>

                    <TextView
                        style="@style/SF.Pill.Safe"
                        android:layout_marginStart="9dp"
                        android:drawableStart="@drawable/ic12_check_circle"
                        android:text="Aman" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <!-- Sunlight -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:paddingVertical="10dp">

                    <FrameLayout
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_product_home">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_droplet"
                            app:tint="#397A55" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Sunlight 755ml" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="SKU-RMH-001 · Kebutuhan Rumah" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SF.Text.Strong"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:text="5"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/SF.Text.Caption"
                                android:layout_marginStart="3dp"
                                android:text="pcs" />
                        </LinearLayout>

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="min. 15" />
                    </LinearLayout>

                    <TextView
                        style="@style/SF.Pill.Warn"
                        android:layout_marginStart="9dp"
                        android:drawableStart="@drawable/ic12_alert_triangle"
                        android:text="Menipis" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <!-- Tisu Basah -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:paddingVertical="10dp">

                    <FrameLayout
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_product_other">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_package"
                            app:tint="#66756C" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Tisu Basah" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="SKU-LNY-001 · Lainnya" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SF.Text.Strong"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:text="0"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/SF.Text.Caption"
                                android:layout_marginStart="3dp"
                                android:text="pack" />
                        </LinearLayout>

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="min. 10" />
                    </LinearLayout>

                    <TextView
                        style="@style/SF.Pill.Warn"
                        android:layout_marginStart="9dp"
                        android:drawableStart="@drawable/ic12_alert_triangle"
                        android:text="Menipis" />
                </LinearLayout>
            </LinearLayout>

            <!-- csv-note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginStart="4dp"
                    android:text="Total unit menjumlahkan satuan berbeda (pcs, box, pack); bukan nilai uang — skema tidak punya kolom harga."
                    android:textColor="@color/sf_muted_2" />
            </LinearLayout>

            <!-- Sumber -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginStart="4dp"
                    android:text="Sumber: v_stok_tersedia · status_stok ≤ stok_minimum = Stok Menipis"
                    android:textColor="@color/sf_muted_2" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/view_tabbar_owner_laporan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
