<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil pemilik — draft.html profilePage() (Budi Santoso @pemilik). Tab aktif: Profil.
  Angka: aktivitas saya = 4 (riwayat user_id 1), batch saya = 4 (MGN-2411A/B, PRC-2410A/B), akun = 2.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <!-- Topbar tab utama (tanpa aksi) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="66dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SF.Text.Title"
                android:singleLine="true"
                android:text="Profil"
                android:textSize="18sp" />

            <TextView
                style="@style/SF.Text.Caption"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:text="Akun &amp; preferensi" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Profile hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_avatar_lg"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:gravity="center"
                    android:text="BS"
                    android:textColor="#17523A"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.Title"
                        android:text="Budi Santoso"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/SF.Text.RowSub"
                        android:layout_marginTop="3dp"
                        android:text="\@pemilik · akun aktif" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SF.Pill.Brand"
                            android:text="Pemilik" />

                        <TextView
                            style="@style/SF.Pill.Safe"
                            android:layout_marginStart="5dp"
                            android:drawableStart="@drawable/ic12_check_circle"
                            android:text="Aktif" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Statistik -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.03"
                        android:text="4"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="aktivitas saya" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.03"
                        android:text="4"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="batch saya" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.03"
                        android:text="2"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="akun pengguna" />
                </LinearLayout>
            </LinearLayout>

            <!-- Kelola -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <TextView
                    style="@style/SF.Text.Section"
                    android:text="Kelola" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="3dp"
                    android:text="Menu sesuai peran akun" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical">

                <!-- Akun pengguna -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_ic_mint">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_users"
                            app:tint="@color/sf_brand" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Akun pengguna" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="Pemilik &amp; staf · aktif/nonaktif" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/sf_chev" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <!-- Pengaturan -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_ic_mint">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/sf_brand" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Pengaturan" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="Ambang kedaluwarsa, lampiran, impor" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/sf_chev" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <!-- Notifikasi -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_ic_warn">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/sf_warn" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Notifikasi" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="4 belum ditampilkan" />
                    </LinearLayout>

                    <TextView
                        style="@style/SF.Pill.Danger"
                        android:layout_marginStart="10dp"
                        android:text="4" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/sf_chev" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <!-- Data & skema -->
                <LinearLayout
                    style="@style/SF.Row"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_ic_info">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_database"
                            app:tint="@color/sf_info" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Data &amp; skema" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="9 tabel · 2 view · ekspor JSON" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/sf_chev" />
                </LinearLayout>
            </LinearLayout>

            <!-- Akun -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <TextView
                    style="@style/SF.Text.Section"
                    android:text="Akun" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="3dp"
                    android:text="Sesi dan keamanan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/SF.Row"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_ic_danger">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_logout"
                            app:tint="@color/sf_danger" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Keluar &amp; ganti akun" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="Kembali ke layar masuk" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/sf_chev" />
                </LinearLayout>
            </LinearLayout>

            <!-- Owner note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert_warn"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="9dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/sf_warn_ink" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_marginStart="7dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Data uji memakai kata sandi password untuk kedua akun. Di Laravel, kata sandi disimpan sebagai hash bcrypt dan token Sanctum dicabut saat akun dinonaktifkan."
                    android:textColor="@color/sf_warn_ink"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Footer brand -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_brand_mark">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_layers"
                            app:tint="#D9F7E8" />
                    </FrameLayout>

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:text="StockFlow · Edisi Database"
                        android:textColor="@color/sf_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="5dp"
                    android:text="v1.0 · 30 Oktober 2026 · dari stockflow_database.sql" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/view_tabbar_owner_profil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
