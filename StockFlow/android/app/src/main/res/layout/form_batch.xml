<?xml version="1.0" encoding="utf-8"?>
<!--
  Form batch baru / stok masuk — draft.html batchFormPage().
  Tanggal kedaluwarsa default = hari ini (Jum, 30 Okt 2026) + 30 hari = 29 Nov 2026 -> status Mendekati.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Batch baru"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Form intro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <TextView
                    style="@style/SF.Text.Title"
                    android:text="Batch baru" />

                <TextView
                    style="@style/SF.Text.Muted"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Stok masuk dicatat sebagai batch dengan tanggal kedaluwarsa sendiri. Sistem membuat mutasi masuk dan riwayat aktivitas otomatis."
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Section: Barang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_box"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Barang" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Wajib"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Pilih barang" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/select_barang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="42dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp">

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Indomie Goreng · SKU-MKN-001"
                        android:textColor="@color/sf_ink"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#799085" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/sf_muted" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Satu barang boleh punya banyak batch." />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Identitas batch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_tag"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Identitas batch" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Wajib"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <!-- Nomor batch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Nomor batch" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="end"
                        android:text="Unik per barang"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:minHeight="42dp"
                    android:orientation="horizontal"
                    android:paddingStart="11dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_tag"
                        app:tint="#8EA096" />

                    <EditText
                        android:id="@+id/et_nomor_batch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Contoh: MGN-2412A"
                        android:includeFontPadding="false"
                        android:inputType="textCapCharacters"
                        android:maxLength="100"
                        android:paddingStart="8dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="11dp"
                        android:textColor="@color/sf_ink"
                        android:textColorHint="#A1B0A8"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Jumlah awal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Jumlah awal" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btn_batch_minus"
                        android:layout_width="37dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="11.5dp"
                        android:paddingVertical="14dp"
                        android:src="@drawable/ic_minus"
                        app:tint="#486458" />

                    <EditText
                        android:id="@+id/batch_jumlah"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:inputType="number"
                        android:padding="0dp"
                        android:text="10"
                        android:textColor="@color/sf_ink"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btn_batch_plus"
                        android:layout_width="37dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="11.5dp"
                        android:paddingVertical="14dp"
                        android:src="@drawable/ic_plus"
                        app:tint="#486458" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/sf_muted" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.2"
                        android:text="jumlah_sisa diisi sama dengan jumlah_awal saat batch dibuat." />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Kedaluwarsa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Kedaluwarsa" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Wajib"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Tanggal kedaluwarsa" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/select_tanggal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="42dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp">

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="29/11/2026"
                        android:textColor="@color/sf_ink"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#799085" />
                </LinearLayout>

                <!-- Status preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_status_preview"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status otomatis" />

                    <TextView
                        style="@style/SF.Pill.Warn"
                        android:drawableStart="@drawable/ic12_clock"
                        android:text="Mendekati" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/sf_muted" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Ambang peringatan saat ini 30 hari. Batas atas persis di ambang dianggap Mendekati Kedaluwarsa." />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Lampiran bukti -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_image"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Lampiran bukti" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Opsional"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/btn_pilih_foto"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_upload"
                        app:tint="@color/sf_ghost_text" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="7dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Pilih foto batch"
                        android:textColor="@color/sf_ghost_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/sf_muted" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.2"
                        android:text="JPG/PNG maks 2 MB. Disimpan sebagai baris lampiran jenis bukti_batch." />
                </LinearLayout>
            </LinearLayout>

            <!-- Form note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_alert_info"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_clipboard_check"
                    app:tint="#35647E" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Menyimpan batch akan menambah mutasi masuk sebesar jumlah awal dan mencatat riwayat tambah batch_stok."
                    android:textColor="#35647E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sumber -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_marginStart="4dp"
                    android:text="Sumber: tabel batch_stok + mutasi_stok · FEFO memakai tanggal_kedaluwarsa"
                    android:textColor="@color/sf_muted_2"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Actionbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_actionbar"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/btn_batal"
            style="@style/SF.Btn.Ghost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Batal" />

        <TextView
            android:id="@+id/btn_simpan"
            style="@style/SF.Btn.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic12_save"
            android:text="Simpan batch" />
    </LinearLayout>
</LinearLayout>
