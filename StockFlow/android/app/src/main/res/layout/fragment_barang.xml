                android:background="@drawable/bg_badge"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/sf_on_brand"
                android:textSize="8sp" />
        </FrameLayout>
