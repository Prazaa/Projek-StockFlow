                android:singleLine="true"
                android:text="Barang"
                android:textSize="18sp" />

            <TextView
                style="@style/SF.Text.Caption"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:text="Master barang &amp; batch stok" />
