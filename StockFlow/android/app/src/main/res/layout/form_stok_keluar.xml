<?xml version="1.0" encoding="utf-8"?>
<!--
  Form catat stok keluar (FEFO) — draft.html stockOutPage().
  Contoh pratinjau: Indomie Goreng, jumlah 120 -> MGN-2411B 50 pcs lalu MGN-2411A 70 pcs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Stok keluar"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Form intro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <TextView
                    style="@style/SF.Text.Title"
                    android:text="Catat stok keluar" />

                <TextView
                    style="@style/SF.Text.Muted"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Alokasi otomatis memakai FEFO: batch dengan tanggal kedaluwarsa terdekat dipotong lebih dulu. Setiap batch yang terpakai menghasilkan satu baris mutasi keluar."
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Section: Pengeluaran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_arrow_up_right"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Pengeluaran" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Wajib"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <!-- Barang -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Barang" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/select_barang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="42dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp">

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Indomie Goreng · tersedia 150 pcs"
                        android:textColor="@color/sf_ink"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#799085" />
                </LinearLayout>

                <!-- Jumlah keluar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Jumlah keluar" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btn_keluar_minus"
                        android:layout_width="37dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="11.5dp"
                        android:paddingVertical="14dp"
                        android:src="@drawable/ic_minus"
                        app:tint="#486458" />

                    <EditText
                        android:id="@+id/keluar_jumlah"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:inputType="number"
                        android:padding="0dp"
                        android:text="120"
                        android:textColor="@color/sf_ink"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btn_keluar_plus"
                        android:layout_width="37dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="11.5dp"
                        android:paddingVertical="14dp"
                        android:src="@drawable/ic_plus"
                        app:tint="#486458" />
                </LinearLayout>

                <!-- Catatan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Catatan" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="end"
                        android:text="Opsional"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_catatan"
                    style="@style/SF.Input"
                    android:layout_marginTop="5dp"
                    android:hint="Contoh: Penjualan harian"
                    android:maxLength="255"
                    android:text="Penjualan harian" />
            </LinearLayout>

            <!-- Section: Pratinjau alokasi FEFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_layers"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Pratinjau alokasi FEFO" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Otomatis"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <!-- Tersedia + pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp">

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:text="Tersedia " />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="150 pcs"
                        android:textColor="@color/sf_ink" />

                    <TextView
                        style="@style/SF.Pill.Safe"
                        android:text="Cukup" />
                </LinearLayout>

                <!-- Alloc list -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_alloc"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            style="@style/SF.Text.Mono"
                            android:fontFamily="monospace"
                            android:text="MGN-2411B"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/SF.Text.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=" · exp 29 Nov 2026" />

                        <TextView
                            style="@style/SF.Text"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:text="50 pcs"
                            android:textColor="@color/sf_brand"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View style="@style/SF.Divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            style="@style/SF.Text.Mono"
                            android:fontFamily="monospace"
                            android:text="MGN-2411A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/SF.Text.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=" · exp 30 Nov 2026" />

                        <TextView
                            style="@style/SF.Text"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:text="70 pcs"
                            android:textColor="@color/sf_brand"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Field hint -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/sf_muted" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Total 120 pcs akan dipotong dari 2 batch, satu baris mutasi per batch." />
                </LinearLayout>
            </LinearLayout>

            <!-- Form note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_alert_info"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_info"
                    app:tint="#35647E" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Stok tersedia dihitung dari batch yang belum kedaluwarsa dan belum ditangani (view v_stok_tersedia)."
                    android:textColor="#35647E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sumber -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_marginStart="4dp"
                    android:text="Sumber: mutasi_stok.jenis = keluar · satu baris per batch terpakai"
                    android:textColor="@color/sf_muted_2"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Actionbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_actionbar"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/btn_batal"
            style="@style/SF.Btn.Ghost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Batal" />

        <TextView
            android:id="@+id/btn_catat_keluar"
            style="@style/SF.Btn.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic12_arrow_up_right"
            android:text="Catat keluar" />
    </LinearLayout>
</LinearLayout>
