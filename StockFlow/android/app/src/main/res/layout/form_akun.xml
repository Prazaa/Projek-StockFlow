<?xml version="1.0" encoding="utf-8"?>
<!--
  Form akun (mode Tambah) — draft.html userFormPage(null).
  Kolom tabel users: nama, username, password (bcrypt), peran, aktif.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Tambah akun"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Form intro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <TextView
                    style="@style/SF.Text.Title"
                    android:text="Tambah akun" />

                <TextView
                    style="@style/SF.Text.Muted"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Buat akun staf atau pemilik. Tidak ada registrasi mandiri; akun dikelola pemilik."
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Section: Identitas akun -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_user"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Identitas akun" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Wajib"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <!-- Nama lengkap -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Nama lengkap" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_nama"
                    style="@style/SF.Input"
                    android:layout_marginTop="5dp"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100" />

                <!-- Username -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Username" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="end"
                        android:text="Unik"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:minHeight="42dp"
                    android:orientation="horizontal"
                    android:paddingStart="11dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_key"
                        app:tint="#8EA096" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:includeFontPadding="false"
                        android:inputType="textNoSuggestions"
                        android:maxLength="50"
                        android:paddingStart="8dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="11dp"
                        android:textColor="@color/sf_ink"
                        android:textColorHint="#A1B0A8"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Kata sandi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Kata sandi" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_password"
                    style="@style/SF.Input"
                    android:layout_marginTop="5dp"
                    android:hint="Minimal 6 karakter"
                    android:inputType="textPassword" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/sf_muted" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Simulasi mockup; Laravel menyimpan hash bcrypt." />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Peran & status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_16"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_marginStart="7dp"
                        android:text="Peran &amp; status" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="end"
                        android:letterSpacing="0.07"
                        android:text="Wajib"
                        android:textAllCaps="true"
                        android:textColor="@color/sf_muted_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    style="@style/SF.Divider"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Text.Label"
                        android:text="Peran" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/sf_danger"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/select_peran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="42dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp">

                    <TextView
                        style="@style/SF.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Staf"
                        android:textColor="@color/sf_ink"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#799085" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/sf_muted" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Pemilik dapat mengelola akun, pengaturan, dan laporan. Staf fokus operasional stok &amp; riwayat sendiri." />
                </LinearLayout>

                <!-- Switch: Akun aktif -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="2dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Akun aktif" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="Nonaktif = login ditolak &amp; token dicabut." />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_aktif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Form note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_alert_info"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_clipboard_check"
                    app:tint="#35647E" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Menyimpan akun mencatat riwayat aktivitas tambah users. Username harus unik."
                    android:textColor="#35647E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sumber -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_marginStart="4dp"
                    android:text="Sumber: tabel users · password bcrypt · peran pemilik/staf"
                    android:textColor="@color/sf_muted_2"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Actionbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_actionbar"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/btn_batal"
            style="@style/SF.Btn.Ghost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Batal" />

        <TextView
            android:id="@+id/btn_simpan"
            style="@style/SF.Btn.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic12_save"
            android:text="Buat akun" />
    </LinearLayout>
</LinearLayout>
