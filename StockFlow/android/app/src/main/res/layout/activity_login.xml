<?xml version="1.0" encoding="utf-8"?>
<!-- Login — draft.html loginPage() / .auth. Tema gelap hijau, kartu kaca, akun data uji. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:ignore="HardcodedText,ContentDescription,Autofill,LabelFor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <!-- Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_auth_brand_mark">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_layers"
                    app:tint="@color/sf_auth_mark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SF.Text"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:text="StockFlow"
                    android:textColor="#F2FFF9"
                    android:textSize="16sp" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="0.14"
                    android:text="EDISI DATABASE"
                    android:textColor="#84B9A2"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SF.Text"
            android:fontFamily="@font/plus_jakarta_sans_extrabold"
            android:letterSpacing="0.16"
            android:text="MANAJEMEN STOK &amp; KEDALUWARSA"
            android:textColor="@color/sf_auth_eyebrow"
            android:textSize="10sp" />

        <TextView
            style="@style/SF.Text"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_extrabold"
            android:letterSpacing="-0.04"
            android:lineSpacingMultiplier="0.95"
            android:text="Masuk ke\ngudang."
            android:textColor="@color/sf_auth_text"
            android:textSize="34sp" />

        <TextView
            style="@style/SF.Text"
            android:layout_width="300dp"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.25"
            android:text="Kelola barang, batch, mutasi, dan penanganan kedaluwarsa — sesuai skema stockflow_database.sql."
            android:textColor="@color/sf_auth_lede"
            android:textSize="12sp" />

        <!-- Kartu kaca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_auth_card"
            android:orientation="vertical"
            android:padding="15dp">

            <!-- Username -->
            <TextView
                style="@style/SF.Text.Label"
                android:text="Username *"
                android:textColor="@color/sf_auth_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_auth_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/sf_auth_icon" />

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="pemilik atau staf"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/sf_auth_text"
                    android:textColorHint="@color/sf_auth_hint"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Kata sandi -->
            <TextView
                style="@style/SF.Text.Label"
                android:layout_marginTop="12dp"
                android:text="Kata sandi *"
                android:textColor="@color/sf_auth_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_auth_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingEnd="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/sf_auth_icon" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/sf_auth_text"
                    android:textColorHint="@color/sf_auth_hint"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btn_toggle_password"
                    style="@style/SF.IconBtn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/sf_auth_icon" />
            </LinearLayout>

            <!-- Tombol Masuk -->
            <TextView
                android:id="@+id/btn_masuk"
                style="@style/SF.Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:drawableStart="@drawable/ic_login"
                android:text="Masuk" />

            <!-- Pemisah -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#26B7E3CB" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_marginHorizontal="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="0.1"
                    android:text="AKUN DATA UJI"
                    android:textColor="@color/sf_auth_foot"
                    android:textSize="9sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#26B7E3CB" />
            </LinearLayout>

            <!-- Demo: pemilik -->
            <LinearLayout
                android:id="@+id/demo_pemilik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_auth_demo"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_auth_avatar"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:gravity="center"
                    android:text="BS"
                    android:textColor="#C8F2DD"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Budi Santoso"
                        android:textColor="#EDFFF7"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginTop="2dp"
                        android:text="@pemilik · kata sandi: password"
                        android:textColor="#8AB49F"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    style="@style/SF.Pill"
                    android:background="@drawable/bg_auth_pill"
                    android:text="Pemilik"
                    android:textColor="#B5D9C7"
                    android:textSize="9sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="9dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8EBAA5" />
            </LinearLayout>

            <!-- Demo: staf -->
            <LinearLayout
                android:id="@+id/demo_staf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_auth_demo"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_auth_avatar"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:gravity="center"
                    android:text="RW"
                    android:textColor="#C8F2DD"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Rina Wulandari"
                        android:textColor="#EDFFF7"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginTop="2dp"
                        android:text="@staf · kata sandi: password"
                        android:textColor="#8AB49F"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    style="@style/SF.Pill"
                    android:background="@drawable/bg_auth_pill"
                    android:text="Staf"
                    android:textColor="#B5D9C7"
                    android:textSize="9sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="9dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8EBAA5" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dorong footer ke bawah -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_auth_note"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/ic_database"
                app:tint="#8DC8AB" />

            <TextView
                style="@style/SF.Text"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.25"
                android:text="Data uji: 5 barang · 7 batch · 4 notifikasi. Status dihitung relatif terhadap hari ini."
                android:textColor="#90B7A3"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/sf_auth_foot_strong" />

            <TextView
                style="@style/SF.Text.Mono"
                android:layout_marginStart="5dp"
                android:text="stockflow_database.sql · MySQL 8 · Laravel Sanctum"
                android:textColor="@color/sf_auth_foot_strong"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
