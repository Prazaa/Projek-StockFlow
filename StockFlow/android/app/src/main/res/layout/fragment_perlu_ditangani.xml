<?xml version="1.0" encoding="utf-8"?>
<!--
  Halaman perlu ditangani — draft.html perluPage().
  View v_perlu_ditangani: batch Kedaluwarsa & belum Ditangani.
  Data contoh = seed: MLK-2411B, Ultra Milk, sisa 30 pcs, lewat 1 hari.
  Tanpa tab bar (sub-halaman).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Perlu ditangani"
            android:textSize="18sp" />

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                style="@style/SF.IconBtn"
                android:src="@drawable/ic_bell" />

            <TextView
                style="@style/SF.Text"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/sf_on_brand"
                android:textSize="8sp" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ic_danger">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_package_x"
                        app:tint="@color/sf_danger" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:letterSpacing="-0.035"
                        android:text="Perlu Ditangani"
                        android:textColor="@color/sf_ink"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:text="View " />

                        <TextView
                            style="@style/SF.Text.Mono"
                            android:fontFamily="monospace"
                            android:text="v_perlu_ditangani"
                            android:textColor="@color/sf_muted"
                            android:textSize="10sp" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:text=" · batch Kedaluwarsa" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Peringatan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert_danger"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_alert_triangle"
                    app:tint="@color/sf_danger_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="1 batch menunggu penanganan."
                        android:textColor="@color/sf_danger_ink"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="Stok kedaluwarsa tidak boleh dijual. Pilih tindakan: dimusnahkan, dikembalikan ke pemasok, atau lainnya."
                        android:textColor="@color/sf_danger_ink"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Kartu batch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_14"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_product_drink">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cup"
                            app:tint="#2C6B93" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.RowTitle"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Ultra Milk Full Cream 250ml" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SF.Text.BatchCode"
                                android:text="MLK-2411B" />

                            <TextView
                                style="@style/SF.Text.RowSub"
                                android:layout_marginStart="4dp"
                                android:text="· SKU-MNM-001"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/SF.Pill.Danger"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/ic12_alert_triangle"
                        android:text="Kedaluwarsa" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/sf_line" />

                <!-- Metrik batch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:letterSpacing="0.06"
                            android:text="SISA"
                            android:textColor="@color/sf_muted_2"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SF.Text"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:text="30"
                                android:textColor="@color/sf_ink"
                                android:textSize="11sp" />

                            <TextView
                                style="@style/SF.Text"
                                android:layout_marginStart="2dp"
                                android:paddingBottom="1dp"
                                android:text="pcs"
                                android:textColor="@color/sf_muted"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:letterSpacing="0.06"
                            android:text="KEDALUWARSA"
                            android:textColor="@color/sf_muted_2"
                            android:textSize="9sp" />

                        <TextView
                            style="@style/SF.Text"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="29 Okt 2026"
                            android:textColor="@color/sf_ink"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:letterSpacing="0.06"
                            android:text="LEWAT"
                            android:textColor="@color/sf_muted_2"
                            android:textSize="9sp" />

                        <TextView
                            style="@style/SF.Text"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="1 hari"
                            android:textColor="@color/sf_danger"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Aksi batch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SF.Btn.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic12_box"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Barang"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/SF.Btn.Danger"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic12_package_x"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Tangani batch"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Catatan sumber -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginStart="6dp"
                    android:text="Sumber: view v_perlu_ditangani · sisa_hari = DATEDIFF(tanggal_kedaluwarsa, hari ini)" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
