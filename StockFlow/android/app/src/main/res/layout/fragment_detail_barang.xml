<?xml version="1.0" encoding="utf-8"?>
<!--
  Detail barang — draft.html itemDetailPage() untuk Sunlight 755ml (id 4, stok menipis).
  Data contoh = seed stockflow_database.sql (30 Okt 2026). Tanpa tabbar; actionbar bawah.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Detail barang"
            android:textSize="18sp" />

        <ImageView
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_more_v" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Detail hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_product_home">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_droplet"
                        app:tint="#397A55" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.Title"
                        android:lineSpacingMultiplier="1.05"
                        android:text="Sunlight 755ml" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">

                        <TextView
                            android:id="@+id/meta_sku"
                            style="@style/SF.Text.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SKU-RMH-001"
                            android:textColor="@color/sf_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/meta_dot1"
                            style="@style/SF.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="·" />

                        <TextView
                            android:id="@+id/meta_kategori"
                            style="@style/SF.Pill.Outline"
                            android:text="Kebutuhan Rumah" />

                        <TextView
                            android:id="@+id/meta_dot2"
                            style="@style/SF.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="·" />

                        <TextView
                            android:id="@+id/meta_satuan"
                            style="@style/SF.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="pcs"
                            android:textSize="11sp" />

                        <androidx.constraintlayout.helper.widget.Flow
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="meta_sku,meta_dot1,meta_kategori,meta_dot2,meta_satuan"
                            app:flow_horizontalBias="0"
                            app:flow_horizontalGap="6dp"
                            app:flow_horizontalStyle="packed"
                            app:flow_verticalGap="5dp"
                            app:flow_wrapMode="chain"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <ImageView
                    style="@style/SF.IconBtn.Boxed"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_more_v" />
            </LinearLayout>

            <!-- Alert strip: stok di bawah minimum -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert_warn"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/sf_warn_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Stok di bawah minimum."
                        android:textColor="@color/sf_warn_ink"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="Tersedia 5 pcs dari minimum 15 pcs. Segera catat stok masuk."
                        android:textColor="@color/sf_warn_ink"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stock card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_tint"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Eyebrow"
                            android:text="Stok tersedia" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SF.Text"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:letterSpacing="-0.05"
                                android:text="5"
                                android:textColor="@color/sf_ink"
                                android:textSize="32sp" />

                            <TextView
                                style="@style/SF.Text.Muted"
                                android:layout_marginStart="5dp"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:text="pcs" />
                        </LinearLayout>

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="5dp"
                            android:text="Minimum 15 pcs" />
                    </LinearLayout>

                    <TextView
                        style="@style/SF.Pill.Warn"
                        android:layout_marginStart="10dp"
                        android:drawableStart="@drawable/ic12_alert_triangle"
                        android:text="Stok Menipis" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        style="@style/SF.Progress.Warn"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:progress="33" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginStart="7dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="5/15" />
                </LinearLayout>

                <TextView
                    style="@style/SF.Text.Muted"
                    android:layout_marginTop="7dp"
                    android:text="1 batch menyumbang stok tersedia. Batch kedaluwarsa dan ditangani tidak dihitung." />
            </LinearLayout>

            <!-- Batch stok -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.Section"
                        android:text="Batch stok" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="3dp"
                        android:text="1 batch · urut FEFO" />
                </LinearLayout>

                <TextView
                    style="@style/SF.Text.Link"
                    android:drawableEnd="@drawable/ic12_plus"
                    android:text="Tambah"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="2dp">

                <LinearLayout style="@style/SF.Row">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_ic_mint">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_layers"
                            app:tint="@color/sf_brand" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Mono"
                            android:fontFamily="monospace"
                            android:text="SUN-2412A"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/SF.Text.RowSub"
                            android:layout_marginTop="3dp"
                            android:text="Sisa 5 / 24 pcs · exp 29 Des 2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Pill.Safe"
                            android:drawableStart="@drawable/ic12_check_circle"
                            android:text="Aman" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="3dp"
                            android:text="60 hr lagi" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/sf_chev" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mutasi terbaru -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.Section"
                        android:text="Mutasi terbaru" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="3dp"
                        android:text="2 dari total 2 mutasi" />
                </LinearLayout>

                <TextView
                    style="@style/SF.Text.Link"
                    android:drawableEnd="@drawable/ic12_chevron_right"
                    android:text="Laporan"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/SF.Card"
                android:layout_marginTop="10dp">

                <!-- Keluar 19 pcs -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="13dp"
                        android:layout_marginTop="27dp"
                        android:background="@color/sf_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="13dp">

                        <FrameLayout
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:background="@drawable/bg_ic_danger">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_arrow_up_right"
                                app:tint="@color/sf_danger" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="1dp">

                            <TextView
                                style="@style/SF.Text.Strong"
                                android:text="Keluar 19 pcs · SUN-2412A" />

                            <TextView
                                style="@style/SF.Text.RowSub"
                                android:layout_marginTop="2dp"
                                android:text="Penjualan harian · Rina Wulandari" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:gravity="end"
                            android:orientation="vertical"
                            android:paddingTop="1dp">

                            <TextView
                                style="@style/SF.Text"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:text="−19"
                                android:textColor="@color/sf_danger" />

                            <TextView
                                style="@style/SF.Text.Caption"
                                android:layout_marginTop="2dp"
                                android:text="10.12" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- Masuk 24 pcs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:background="@drawable/bg_ic_safe">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_down_left"
                            app:tint="@color/sf_safe" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="1dp">

                        <TextView
                            style="@style/SF.Text.Strong"
                            android:text="Masuk 24 pcs · SUN-2412A" />

                        <TextView
                            style="@style/SF.Text.RowSub"
                            android:layout_marginTop="2dp"
                            android:text="Stok awal · Rina Wulandari" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:gravity="end"
                        android:orientation="vertical"
                        android:paddingTop="1dp">

                        <TextView
                            style="@style/SF.Text"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:text="+24"
                            android:textColor="@color/sf_safe" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="2dp"
                            android:text="07.48" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Informasi barang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <TextView
                    style="@style/SF.Text.Section"
                    android:text="Informasi barang" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="3dp"
                    android:text="Kolom tabel barang" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="ID barang" />

                    <TextView
                        style="@style/SF.Text.Mono"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="#4"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Kode SKU" />

                    <TextView
                        style="@style/SF.Text.Mono"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="SKU-RMH-001"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Kategori" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="Kebutuhan Rumah" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Satuan" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="pcs" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Stok minimum" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="15 pcs" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Dibuat oleh" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="Budi Santoso" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Dibuat pada" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="30 Okt 2026 · 07.13 WIB" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Deleted at" />

                    <TextView
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="— (aktif)" />
                </LinearLayout>
            </LinearLayout>

            <!-- Catatan sumber -->
            <TextView
                style="@style/SF.Text.Caption"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic12_database"
                android:drawablePadding="4dp"
                android:drawableTint="@color/sf_muted_2"
                android:gravity="center_vertical"
                android:paddingHorizontal="2dp"
                android:text="Sumber: barang #4 · view v_stok_tersedia"
                android:textColor="@color/sf_muted_2" />
        </LinearLayout>
    </ScrollView>

    <!-- Actionbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_actionbar"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <TextView
            style="@style/SF.Btn.Ghost"
            android:layout_width="0dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic12_arrow_up_right"
            android:text="Stok keluar" />

        <TextView
            style="@style/SF.Btn.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic12_plus"
            android:text="Tambah batch" />
    </LinearLayout>
</LinearLayout>
